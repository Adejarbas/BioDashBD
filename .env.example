# ==========================================
# BIODASHBD - BACKEND NEXT.JS (ENV EXAMPLE)
# ==========================================

# Servidor e Ambiente
NODE_ENV=development
PORT=3003

# URLs da Aplicação
API_BASE_URL=http://localhost:3003
FRONTEND_URL=http://localhost:80

# Autenticação e Segurança
JWT_SECRET=seu_jwt_secret_aqui

# ==============================================================================
# 🔷 NECESSÁRIAS PARA O AZURE (STORAGE E BANCO DE DADOS)
# ==============================================================================

# [AZURE BLOB STORAGE] - Gerenciamento de Fotos de Perfil e Arquivos
# Obtenha no Azure Portal: Storage account > Security + networking > Access keys
# Opção A (Recomendada): Connection String completa
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=seunome;AccountKey=suachave==;EndpointSuffix=core.windows.net

# Opção B (Alternativa): Nome da conta + Chave de Acesso
AZURE_STORAGE_ACCOUNT_NAME=seunome
AZURE_STORAGE_ACCOUNT_KEY=suachave==

# Nome do container criado na Storage Account (deve estar criado no Azure)
AZURE_STORAGE_CONTAINER_NAME=biogen-avatars

# [AZURE DATABASE FOR POSTGRESQL] - Banco Relacional (Flexible Server)
POSTGRES_URL=postgresql://<admin_user>:<admin_password>@<server_name>.postgres.database.azure.com:5432/biodash_db?sslmode=require

# ==============================================================================
# OUTROS SERVIÇOS (IA & OBSERVABILIDADE)
# ==============================================================================

# Microserviço de Chatbot e PLN (BioDash_ai-service)
AI_SERVICE_URL=http://localhost:5000

# E-mail Transacional (opcional)
RESEND_API_KEY=re_sua_chave_resend_aqui

# Observabilidade (BetterStack / Logtail - opcional)
LOGTAIL_TOKEN=seu_logtail_token_aqui
LOGTAIL_URL=seu_logtail_url_aqui
