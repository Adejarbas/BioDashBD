# ==============================================================================
# BIODASHBD - BACKEND NEXT.JS (ENV EXAMPLE)
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente.
# NUNCA envie senhas ou credenciais de produção para o repositório Git.

# ------------------------------------------------------------------------------
# SERVIDOR E AMBIENTE LOCAL
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3003

# URLs da Aplicação
API_BASE_URL=http://localhost:3003
FRONTEND_URL=http://localhost:80

# ------------------------------------------------------------------------------
# AUTENTICAÇÃO E SEGURANÇA
# ------------------------------------------------------------------------------
# Chave secreta para assinatura dos tokens JWT locais
JWT_SECRET=seu_jwt_secret_super_seguro_aqui

# ------------------------------------------------------------------------------
# BANCO DE DADOS PRINCIPAL (POSTGRESQL)
# ------------------------------------------------------------------------------
# Conexão com banco PostgreSQL (Supabase, Azure Flexible Server ou Local)
# Exemplo local: postgresql://postgres:postgres@localhost:5432/biodash_db
# Exemplo Azure: postgresql://biodashadmin:<sua-senha>@psql-biodash-prod.postgres.database.azure.com:5432/biodash_db?sslmode=require
POSTGRES_URL=postgresql://usuario:senha@localhost:5432/biodash_db

# ------------------------------------------------------------------------------
# ARMAZENAMENTO DE ARQUIVOS (STORAGE / AVATARS)
# ------------------------------------------------------------------------------
# Provedor ativo de storage: 'local' (desenvolvimento em disco) ou 'azure' (Azure Blob Storage)
STORAGE_PROVIDER=local

# Diretório para armazenamento local (usado apenas se STORAGE_PROVIDER=local; opcional)
LOCAL_STORAGE_DIR=./uploads

# Credenciais Azure Blob Storage (obrigatórias apenas se STORAGE_PROVIDER=azure)
# Opção A (Recomendada): Connection String completa
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=seunome;AccountKey=suachave==;EndpointSuffix=core.windows.net
# Opção B (Alternativa): Nome da conta + Chave de Acesso
# AZURE_STORAGE_ACCOUNT_NAME=seunome
# AZURE_STORAGE_ACCOUNT_KEY=suachave==
AZURE_STORAGE_CONTAINER_NAME=biogen-avatars

# ------------------------------------------------------------------------------
# INTEGRAÇÃO COM MICROSERVIÇO DE IA (BioDash_ai-service)
# ------------------------------------------------------------------------------
# Endereço do microserviço FastAPI com modelo Whisper para processamento de áudio/texto
AI_SERVICE_URL=http://127.0.0.1:5000

# ------------------------------------------------------------------------------
# OBSERVABILIDADE E TELEMETRIA (OPCIONAIS)
# ------------------------------------------------------------------------------
# BetterStack / Logtail (Logs remotos)
LOGTAIL_TOKEN=
LOGTAIL_URL=

# Azure Application Insights (Monitoramento OpenTelemetry na Nuvem)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ------------------------------------------------------------------------------
# SUPABASE (LEGADO / CLIENTES AUXILIARES)
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_ANON_KEY=sua_chave_anonima_aqui
