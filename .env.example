# ==========================================
# BIODASHBD - BACKEND NEXT.JS (ENV EXAMPLE)
# ==========================================

# Servidor e Ambiente
NODE_ENV=development
PORT=3003

# Banco de Dados Principal - PostgreSQL (Supabase Pooler)
POSTGRES_URL=postgresql://postgres.[REF]:[SENHA]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Autenticação e Segurança
JWT_SECRET=seu_jwt_secret_aqui

# Supabase (Autenticação, Dados e Storage)
SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_supabase_anon_key_aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_supabase_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_supabase_service_role_key_aqui

# Microserviço de Chatbot e PLN (BioDash_ai-service)
AI_SERVICE_URL=http://localhost:5000

# URLs da Aplicação
API_BASE_URL=http://localhost:3003
FRONTEND_URL=http://localhost:80

# E-mail Transacional (opcional)
RESEND_API_KEY=re_sua_chave_resend_aqui

# Observabilidade (BetterStack / Logtail - opcional)
LOGTAIL_TOKEN=seu_logtail_token_aqui
LOGTAIL_URL=seu_logtail_url_aqui
